  "imputation_and_encoding_policy": {
    "building_floor_proxy": {
      "diagnostic": "9,988 cells have no exact building footprint and therefore no area-weighted floor-count statistic.",
      "policy": "Create a has_building flag before modelling. For grid-level vertical-intensity variables, zero-filled variants are acceptable only when documented as no-building cells; keep original NA-aware fields for sensitivity."
    },
    "canopy_height": {
      "diagnostic": "Canopy NoData gaps are small relative to the study grid.",
      "policy": "Use a canopy_data_available flag. Compare median-imputation-with-flag against dropping cells with missing canopy values."
    },
    "categorical_fields": {
      "dominant_yapitip": "Encode missing as no_building_or_unknown if used in a review model, not in the first morphology-only baseline.",
      "coastal_band": "Use for stratified summaries and sensitivity; prefer continuous coast distance in first predictor sets."
    }
  },
  "collinearity_policy": {
    "source": "outputs/diagnostics/feature_diagnostics_v7_2026-06-18/collinearity_groups_corr95.csv",
    "rule": "For first baselines, use one representative from each abs(r) >= 0.95 group or report family-level ablations.",
