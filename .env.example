# Google Earth Engine
# Required for GEE-based data downloads (Landsat LST, Sentinel-2, Dynamic World, etc.)
EE_PROJECT=your-ee-project-id
# GEE_DRIVE_FOLDER=your-drive-folder-name

# Optional — PROJ and GDAL data directories (Windows / OSGeo4W users)
# Set these if your GDAL-based Python packages can't find projection data.
# PROJ_LIB=C:\OSGeo4W\share\proj
# GDAL_DATA=C:\OSGeo4W\share\gdal

# Optional — QGIS prefix path (only needed by build_mert_qgis_project.py)
# QGIS_PREFIX_PATH=C:\OSGeo4W\apps\qgis-ltr
